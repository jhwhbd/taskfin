# ===== 本地密钥 / 环境变量 =====
.env
.env.*
!.env.example

# ===== 运行时数据卷（docker-compose 挂载到 ./data）=====
data/

# ===== 备份产物 =====
*.zip
backups/

# ===== 系统 / 编辑器 =====
.DS_Store
Thumbs.db
*.swp
*.swo

# ===== 本机工作留痕（AI 修改记录，不入库）=====
docs/本轮AI修改记录.md

# ===== WorkBuddy 工作区配置 =====
.workbuddy/

# ===== 临时分析脚本（不入库）=====
scripts/_*.cjs

# ===== re-vendor 过程临时产物（不入库）=====
# .vendor-bak/  : 品牌化 vendor/ 的临时备份（re-vendor 前生成，回滚用）
# .reclone/     : 上游最新 main 的临时克隆（git ls-remote / 构建机 re-vendor 用）
.vendor-bak/
.reclone/
