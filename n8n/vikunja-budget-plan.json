{
  "name": "Vikunja Budget Plan → ezBookkeeping",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vikunja-plan",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "c1",
      "name": "Vikunja Webhook (created)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "webhookId": "vikunja-plan"
    },
    {
      "parameters": {
        "functionCode": "// P1 防御：校验 webhook 静态密钥（?secret=）。失败直接丢弃，避免公网伪造记账。\nconst expected = (typeof $vars !== 'undefined' && $vars && $vars.webhook_secret) ? $vars.webhook_secret : '';\nconst q = ($input.item.json && $input.item.json.query) || {};\nconst got = q.secret || '';\nif (!(expected && got && got === expected)) {\n  return [];\n}\nreturn $input.all();"
      },
      "id": "c1b",
      "name": "Auth Guard (secret)",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        430,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "// 任务新建时，把 fund: 金额登记为「预算」（仅在 Vikunja 留痕，不写 ezB 真实支出）。\n// A1：预算/计划支出只作可见跟踪，不落 type=3，避免与「完成时记账」重复扣款（见 P2）。\nconst e = $input.item.json;\nif (e.event_name && e.event_name !== 'task.created') return [];\nconst task = (e.data && e.data.task) ? e.data.task : {};\nconst labels = (task.labels || []).map(l => (l.title || l).toString());\nconst m = labels.find(x => x.startsWith('fund:'));\nif (!m) return [];\nconst parts = m.slice(5).split(':');\nconst amount = parseFloat(parts[0]);\nif (Number.isNaN(amount)) return [];\nconst currency = parts[1] || 'CNY';\nconst account = parts[2] || 'cash';\nreturn [{\n  json: {\n    taskId: task.id,\n    title: task.title,\n    fund_amount: amount,\n    fund_currency: currency,\n    fund_account: account,\n    is_recur: labels.includes('recur')\n  }\n}];"
      },
      "id": "c2",
      "name": "Parse Fund Label",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        610,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.is_recur }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "c4",
      "name": "Should Record? (skip recur)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        840,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://vikunja:3456/api/v1/tasks/{{ $json.taskId }}/comments",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $vars.vikunja_token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "comment",
              "value": "=预算 ¥{{ $json.fund_amount }} {{ $json.fund_currency }}（计划支出，任务完成时自动记账到 ezBookkeeping；账户={{ $json.fund_account }}）"
            }
          ]
        }
      },
      "id": "c3",
      "name": "Vikunja Budget Comment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1060,
        300
      ]
    }
  ],
  "connections": {
    "Vikunja Webhook (created)": {
      "main": [
        [
          {
            "node": "Auth Guard (secret)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Auth Guard (secret)": {
      "main": [
        [
          {
            "node": "Parse Fund Label",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Fund Label": {
      "main": [
        [
          {
            "node": "Should Record? (skip recur)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Should Record? (skip recur)": {
      "main": [
        [
          {
            "node": "Vikunja Budget Comment",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "versionId": "1",
  "meta": {
    "instanceId": "local"
  },
  "id": "vikunja-budget-plan"
}
