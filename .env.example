# ============================================================
# 自托管「任务 + 财务」系统 · 环境变量样例
# 用法：复制为 .env 后填入真实值（.env 已在 .gitignore 中，不会入库）
#   cp .env.example .env
# ============================================================

# ===== 域名 =====
# 你的主域名（不含子域）。三个子域 tasks / fin / flow 会自动拼接。
DOMAIN=yourdomain.com

# ===== QQ 邮箱（Vikunja / ezBookkeeping 发信用）=====
# 只填 QQ 号（不含 @qq.com），脚本会自动拼接 @qq.com
QQ_EMAIL=10001

# QQ 邮箱「授权码」（不是登录密码）：
# QQ 邮箱网页版 → 设置 → 账户 → 开启 IMAP/SMTP 服务 → 短信获取 16 位码
QQ_AUTH_CODE=xxxxxxxxxxxxxxxx

# ===== ezBookkeeping 随机密钥 =====
# 在群晖 SSH 执行：openssl rand -base64 32
# 把输出完整粘贴到下面（含可能的 / 和 + 等字符）
EZB_SECRET_KEY=replace-with-openssl-rand-base64-32-output
