# ============================================================
# 自托管「任务 + 财务」系统 · 环境变量样例
# 用法：复制为 .env 后填入真实值（.env 已在 .gitignore 中，不会入库）
#   cp .env.example .env
# ============================================================

# ===== 镜像版本（锁定版，2026-08-18 确认）=====
# 改为具体 tag 而非 latest，保证每次启动拉到的镜像一致。
# 升级时编辑此段对应行 → docker compose pull → docker compose up -d
# 注意：n8n 的 Docker tag 不带 v 前缀（如 1.123.72），与其余不同
#
# ⚠️ Vikunja / ezBookkeeping 已改为「从 vendored 源码构建」（docker-compose.yml 用 build: 而非 image:），
#    下面 VIKUNJA_VERSION / EZB_VERSION 仅作「上游版本记录」参考、不再被 compose 引用
#    （构建使用固定 RELEASE_VERSION）。若要升级这两个组件，请更新 vendor/ 源码后重新 docker compose build。
# ⚠️ 安全：NPM v2.15.1 受 CVE-2026-40519 影响（经认证的 RCE，OS 命令注入，CVSS 4.0=7.7 HIGH，
#    影响区间 2.9.14~2.15.1）。修复 commit a5db5ed 仅合入 develop 分支（2026-06-07），
#    截至最新稳定版 v2.15.1（2026-06-03）【尚未包含修复】，无已发布安全补丁版。
#    当前缓解：compose 已将 NPM 管理端口 81 绑定 127.0.0.1（🔴2），阻断公网/局域网对该后台的访问。
#    处置：待上游发布含 a5db5ed 的稳定版后，将下方版本号升至该版；或自行 build 该 commit。
NPM_VERSION=v2.15.1        # jc21/nginx-proxy-manager（仍用官方镜像；见上方 CVE 警示）
DDNS_VERSION=v6.17.5       # jeessy/ddns-go（仍用官方镜像）
VIKUNJA_VERSION=v2.5.0     # vikunja/vikunja（仅记录；实际从 vendor/ 源码构建）
EZB_VERSION=v1.6.1         # mayswind/ezbookkeeping（仅记录；实际从 vendor/ 源码构建）
N8N_VERSION=1.123.72       # n8nio/n8n（不带 v 前缀，仍用官方镜像）

# ===== 域名 =====
# 你的主域名（不含子域）。三个子域 tasks / fin / flow 会自动拼接。
DOMAIN=yourdomain.com

# ===== 时区（统一驱动各服务，compose 用 ${TZ} 引用）=====
# 改时区只需改这一处。若改为他值时，同步确认 n8n 工作流里的 X-Timezone-Name（当前硬编码 Asia/Shanghai）。
TZ=Asia/Shanghai

# ===== 文件属主（仅当非默认 1000:1000 时需要，如群晖 DSM）=====
# ezBookkeeping 容器以该 UID:GID 运行，数据卷权限需匹配；默认 1000:1000 适配普通 Linux docker 主机。
# 群晖 DSM 的 docker 用户 UID 通常不是 1000：若启动报权限错误，请改为 DSM 实际 UID:GID
# （控制面板 → 终端机 → 执行 `id <你的用户名>` 查看），并同步上方 chown 命令里的数值。
PUID=1000
PGID=1000

# ===== 发信邮箱（Vikunja / ezBookkeeping 发信用）=====
# 变量名沿用 QQ_ 前缀仅为历史习惯；实际支持任意 SMTP 服务商（163 / Gmail / 腾讯企业邮 / 阿里云 / MailPlus 等）。
# 只填账号前缀（不含 @域名），下方自动拼接 @qq.com；若换服务商，请同步修改 compose 内的 MAILER_HOST/PORT 等。
QQ_EMAIL=10001

# 邮箱「授权码 / 客户端密码」（不是登录密码）：
# QQ 邮箱网页版 → 设置 → 账户 → 开启 IMAP/SMTP 服务 → 短信获取 16 位码
QQ_AUTH_CODE=xxxxxxxxxxxxxxxx

# ===== ezBookkeeping 随机密钥 =====
# 在群晖 SSH 执行：openssl rand -base64 32
# 把输出完整粘贴到下面（含可能的 / 和 + 等字符）
EZB_SECRET_KEY=replace-with-openssl-rand-base64-32-output

# ===== n8n Webhook 静态密钥（防公网伪造记账，P1）=====
# 群晖 SSH 执行：openssl rand -hex 16
# 把输出完整粘贴到下面，并同步填到 n8n 变量 webhook_secret、以及 Vikunja Webhook 的 Target URL（?secret=）
WEBHOOK_SECRET=replace-with-openssl-rand-hex-16-output

# ===== n8n 加密密钥（凭证/变量加密，必须显式设置并备份）=====
# 群晖 SSH 执行：openssl rand -base64 32
# 把输出完整粘贴到下面。⚠️ 必须在「首次启动 n8n 之前」设置，且务必备份此值；
# 之后修改会导致已有凭证/变量无法解密。迁移到别机须连同 n8n/ 卷一起带走。
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output
